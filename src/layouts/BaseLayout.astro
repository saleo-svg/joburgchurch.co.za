---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  publishDate?: string;
  schema?: Record<string, unknown>;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description = 'Johannesburg Bible Study Church — a Bible study and welcoming Christian community in Parkmore, Sandton. Wednesday online Bible study 7:30pm. Sunday Korean class 3:00pm. Youth ministry (UseCan). All are welcome.',
  canonicalUrl = Astro.url.href,
  ogImage = '/images/og-default.svg',
  ogType = 'website',
  publishDate,
  schema,
  breadcrumbs,
} = Astro.props;

const siteName = 'Johannesburg Bible Study Church';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const siteUrl = 'https://joburgchurch.co.za';

// Global LocalBusiness schema — present on every page for Google Maps / Knowledge Panel signals
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${siteUrl}/#organization`,
  name: siteName,
  alternateName: 'Joburg Bible Study Church',
  url: siteUrl,
  logo: `${siteUrl}/images/og-default.svg`,
  image: `${siteUrl}/images/og-default.svg`,
  description: 'A Bible study and welcoming Christian community in Sandton, Johannesburg. Wednesday online Bible study, Sunday Korean class, youth programs.',
  telephone: ['+27774871295', '+27674424461'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Parkmore, 11th Street',
    addressLocality: 'Sandton',
    addressRegion: 'Gauteng',
    postalCode: '2196',
    addressCountry: 'ZA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -26.1076,
    longitude: 28.0567,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Wednesday'],
      opens: '19:30',
      closes: '21:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday'],
      opens: '15:00',
      closes: '17:00',
    },
  ],
  priceRange: 'Bible study free; Korean class fee applies',
  areaServed: [
    { '@type': 'City', name: 'Johannesburg' },
    { '@type': 'City', name: 'Sandton' },
    { '@type': 'City', name: 'Randburg' },
    { '@type': 'City', name: 'Fourways' },
    { '@type': 'City', name: 'Midrand' },
    { '@type': 'City', name: 'Alberton' },
    { '@type': 'City', name: 'Roodepoort' },
    { '@type': 'City', name: 'Soweto' },
    { '@type': 'AdministrativeArea', name: 'Gauteng' },
    { '@type': 'Country', name: 'South Africa' },
  ],
  knowsAbout: [
    'Bible Study',
    'Christian Community',
    'Korean Language Class',
    'Youth Ministry',
    'Online Bible Study',
    'Spiritual Education',
    'Worship',
    'Christian Fellowship',
  ],
  sameAs: [
    'https://joburgchurch.co.za',
  ],
};

// WebSite schema with SearchAction — gives Google a site-link
// search box and helps AI engines understand the site's purpose.
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: siteName,
  alternateName: 'Joburg Bible Study Church',
  description: description,
  inLanguage: 'en-ZA',
  publisher: { '@id': `${siteUrl}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/blog/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// Person schema for the lead teacher — this is the strongest
// E-E-A-T signal we can send. AI engines use Person + author
// markup to decide who is allowed to write on a topic.
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#author-mr-sim`,
  name: 'Mr. Sim',
  givenName: 'Sim',
  jobTitle: 'Bible study teacher',
  worksFor: { '@id': `${siteUrl}/#organization` },
  url: `${siteUrl}/about/`,
  telephone: '+27 77 487 1295',
  knowsLanguage: ['en', 'af', 'zu', 'xh', 'st', 'nso', 'tn', 'ss', 've', 'ts'],
  knowsAbout: [
    'Bible study',
    'Christian pastoral care',
    'South African Christianity',
    'Johannesburg community',
    'Marriage counselling',
    'Addiction recovery (Christian framework)',
    'Mental health (Christian framework)',
    'Hymns and worship',
  ],
};

// Person schema for the co-host.
const coHostSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#author-ms-dora`,
  name: 'Ms. Dora',
  givenName: 'Dora',
  jobTitle: 'Bible study co-host',
  worksFor: { '@id': `${siteUrl}/#organization` },
  url: `${siteUrl}/about/`,
  telephone: '+27 67 442 4461',
  knowsLanguage: ['en', 'af', 'zu', 'xh', 'st', 'nso', 'tn', 'ss', 've', 'ts'],
};

// Organization schema — the parent of LocalBusiness and Person.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: siteName,
  alternateName: 'Joburg Bible Study Church',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/images/og-default.svg`,
  },
  image: `${siteUrl}/images/og-default.svg`,
  description: 'A Bible study and welcoming Christian community in Sandton, Johannesburg. Wednesday online Bible study, Sunday Korean class, youth programs.',
  email: 'contact@joburgchurch.co.za',
  telephone: '+27 77 487 1295',
  foundingDate: '2015',
  founder: { '@id': `${siteUrl}/#author-mr-sim` },
  member: [
    { '@id': `${siteUrl}/#author-mr-sim` },
    { '@id': `${siteUrl}/#author-ms-dora` },
  ],
  areaServed: [
    { '@type': 'City', name: 'Johannesburg' },
    { '@type': 'City', name: 'Sandton' },
    { '@type': 'City', name: 'Randburg' },
    { '@type': 'City', name: 'Fourways' },
    { '@type': 'City', name: 'Midrand' },
    { '@type': 'City', name: 'Alberton' },
    { '@type': 'City', name: 'Roodepoort' },
    { '@type': 'City', name: 'Soweto' },
    { '@type': 'City', name: 'Pretoria' },
    { '@type': 'AdministrativeArea', name: 'Gauteng' },
    { '@type': 'Country', name: 'South Africa' },
  ],
  knowsAbout: [
    'Bible Study',
    'Christian Community',
    'Korean Language Class',
    'Youth Ministry',
    'Online Bible Study',
    'Spiritual Education',
    'Worship',
    'Christian Fellowship',
    'Hymns',
    'Pastoral Care',
  ],
  sameAs: [
    'https://joburgchurch.co.za',
    'https://joburgchurch.co.za/about/',
    'https://joburgchurch.co.za/blog/',
    'https://joburgchurch.co.za/hymns/',
  ],
};

// BreadcrumbList schema (optional)
const breadcrumbSchema = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: crumb.name,
    item: crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url}`,
  })),
} : null;

// Combine into single schema graph. Order matters for some AI engines:
// we put WebSite → Organization → Person(s) → LocalBusiness → Article.
const allSchemas: Record<string, unknown>[] = [];
allSchemas.push(webSiteSchema);
allSchemas.push(organizationSchema);
allSchemas.push(authorSchema);
allSchemas.push(coHostSchema);
allSchemas.push(localBusinessSchema);
if (breadcrumbSchema) allSchemas.push(breadcrumbSchema);
if (schema) allSchemas.push(schema);

const combinedJsonLd = JSON.stringify(allSchemas);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="theme-color" content="#1e3a5f" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Geographic / language targeting -->
    <meta name="geo.region" content="ZA-GP" />
    <meta name="geo.placename" content="Sandton, Johannesburg, South Africa" />
    <meta name="geo.position" content="-26.1076;28.0567" />
    <meta name="ICBM" content="-26.1076, 28.0567" />
    <link rel="alternate" hreflang="en-za" href={siteUrl} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="en_ZA" />
    {publishDate && <meta property="article:published_time" content={publishDate} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Performance: DNS prefetch & preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <!--
      Performance: preconnect to AI engines (GEO). When a user clicks
      a citation in ChatGPT or Perplexity that links here, the
      browser has already established the TLS handshake.
    -->
    <link rel="dns-prefetch" href="https://chat.openai.com" />
    <link rel="dns-prefetch" href="https://www.perplexity.ai" />
    <link rel="dns-prefetch" href="https://gemini.google.com" />
    <link rel="dns-prefetch" href="https://claude.ai" />

    <!-- Feed discovery -->
    <link rel="alternate" type="application/rss+xml" title="Johannesburg Bible Study Church Blog" href="/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="Johannesburg Bible Study Church Blog (Atom)" href="/atom.xml" />

    <!-- Google Fonts: Inter (body) + Playfair Display (display) + Cardo (scripture) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cardo:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- ============================================================ -->
    <!-- Google Analytics 4 + Baidu Tongji                            -->
    <!-- ============================================================ -->
    <!--
      GA4_ID is hardcoded (it is a public identifier that appears on every
      page anyway — no security reason to hide it).
      Baidu Tongji stays env-var-gated (set BAIDU_TONGJI_ID at build time
      if you need mainland-China tracking).
    -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LWST7GKLWZ" />
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LWST7GKLWZ', { anonymize_ip: true });
    `} />
    {import.meta.env.BAIDU_TONGJI_ID && (
      <script is:inline async src={`https://hm.baidu.com/hm.js?${import.meta.env.BAIDU_TONGJI_ID}`} />
    )}

    <!-- JSON-LD Schema graph -->
    <script type="application/ld+json" set:html={combinedJsonLd} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>