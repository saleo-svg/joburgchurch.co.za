---
/*
  Share component
  ---------------
  Renders a row of share buttons for Facebook, X (Twitter), WhatsApp, Email, and "Copy link".
  Pure static — uses window.location + intent URLs. No third-party JS.

  Props:
    url   — full URL of the page being shared (defaults to window.location.href at render time)
    title — title to share (defaults to document.title)
    align — "left" | "center" (default: "left")
*/

interface Props {
  url?: string;
  title?: string;
  align?: 'left' | 'center';
  showLabel?: boolean;
}

const { url, title, align = 'left', showLabel = true } = Astro.props;

// At SSR time Astro.url is available. We use it so the share URLs are correct on first paint.
const shareUrl = url ?? Astro.url.href;
const shareTitle = title ?? '';

const encoded = encodeURIComponent;
const fb = `https://www.facebook.com/sharer/sharer.php?u=${encoded(shareUrl)}`;
const tw = `https://twitter.com/intent/tweet?url=${encoded(shareUrl)}&text=${encoded(shareTitle)}`;
const wa = `https://api.whatsapp.com/send?text=${encoded(`${shareTitle} ${shareUrl}`)}`;
const em = `mailto:?subject=${encoded(shareTitle)}&body=${encoded(`${shareTitle}\n${shareUrl}`)}`;

const justify = align === 'center' ? 'justify-center' : 'justify-start';
---

<div class={`flex flex-wrap items-center gap-2 ${justify}`} role="group" aria-label="Share this page">
  {showLabel && <span class="text-xs uppercase tracking-widest text-gray-500 mr-2">Share</span>}

  <a
    href={fb}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on Facebook"
    class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#1877F2] text-white hover:opacity-90 transition-opacity"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
      <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
    </svg>
  </a>

  <a
    href={tw}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on X"
    class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-black text-white hover:opacity-90 transition-opacity"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
  </a>

  <a
    href={wa}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Share on WhatsApp"
    class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#25D366] text-white hover:opacity-90 transition-opacity"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
  </a>

  <a
    href={em}
    aria-label="Share by email"
    class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[color:var(--color-primary)] text-white hover:opacity-90 transition-opacity"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </a>

  <button
    type="button"
    data-share-copy={shareUrl}
    aria-label="Copy link"
    class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-white border border-gray-300 text-gray-700 hover:border-[color:var(--color-warm)] transition-colors"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 015.656 0l1.415 1.415a4 4 0 010 5.656l-3 3a4 4 0 01-5.656 0M10.172 13.828a4 4 0 01-5.656 0l-1.415-1.415a4 4 0 010-5.656l3-3a4 4 0 015.656 0" />
    </svg>
  </button>
</div>

<script>
  // Tiny progressive-enhancement: copy link button.
  // Falls back gracefully if the browser blocks the Clipboard API.
  document.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.shareCopy;
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.getAttribute('aria-label');
        btn.setAttribute('aria-label', 'Copied!');
        btn.classList.add('!bg-[color:var(--color-warm)]', '!text-white', '!border-transparent');
        setTimeout(() => {
          btn.setAttribute('aria-label', original ?? 'Copy link');
          btn.classList.remove('!bg-[color:var(--color-warm)]', '!text-white', '!border-transparent');
        }, 1500);
      } catch {
        // Fallback: prompt
        window.prompt('Copy this link:', url);
      }
    });
  });
</script>