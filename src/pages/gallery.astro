---
import BaseLayout from '@/layouts/BaseLayout.astro';

type GalleryImage = {
  src: string;
  alt: string;
  title: string;
  caption: string;
  category: string;
};

/* Real photography from Unsplash — public Unsplash License */
const images: GalleryImage[] = [
  {
    src: 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=1400&q=80&auto=format&fit=crop',
    alt: 'A diverse group of people sitting together in fellowship',
    title: 'Community Fellowship',
    caption: 'A Sunday afternoon gathering at Parkmore, Sandton — the people who make up the Johannesburg Bible Study Church community.',
    category: 'Community',
  },
  {
    src: 'https://images.unsplash.com/photo-1499209974431-9dddcece7f88?w=1400&q=80&auto=format&fit=crop',
    alt: 'An open Bible on a wooden table during a Wednesday study',
    title: 'The Word Together',
    caption: 'Wednesday evening Bible study on Google Meet — reading the same passage, asking the same questions, finding the same rest.',
    category: 'Bible Study',
  },
  {
    src: 'https://images.unsplash.com/photo-1543269865-cbf427effbad?w=1400&q=80&auto=format&fit=crop',
    alt: 'Students in a language class writing together',
    title: 'Korean Class, Sunday Afternoon',
    caption: 'Beginners welcome. The Hangul alphabet on day one. By the end of the first session, most students can read a Korean restaurant menu.',
    category: 'Korean Class',
  },
  {
    src: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1400&q=80&auto=format&fit=crop',
    alt: 'Young people outdoors at a youth camp gathering',
    title: 'UseCan Youth',
    caption: 'Three days, forty young adults, one weekend — UseCan winter camp at Heia Safari Ranch.',
    category: 'Youth',
  },
  {
    src: 'https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=1400&q=80&auto=format&fit=crop',
    alt: 'A quiet morning landscape with light over the hills',
    title: 'Sandton Mornings',
    caption: 'Where we meet, where we walk — Parkmore and the wider Sandton neighbourhood we are rooted in.',
    category: 'Place',
  },
  {
    src: 'https://images.unsplash.com/photo-1528459801416-a9e53bbf4e17?w=1400&q=80&auto=format&fit=crop',
    alt: 'An open Bible on a quiet table with soft light',
    title: 'Reading Together',
    caption: 'Most Wednesday nights, three things happen: a Bible is opened, a question is asked, and time runs a little longer than planned.',
    category: 'Bible Study',
  },
];

const categories = ['All', ...new Set(images.map((i) => i.category))];
---

<BaseLayout
  title="Photo Gallery | Johannesburg Bible Study Church, Sandton"
  description="Photo gallery of Johannesburg Bible Study Church community life — Bible study gatherings, Korean class, youth events, and fellowship in Sandton, Johannesburg."
>
  <!-- Section header -->
  <section class="section-padding border-b border-gray-100">
    <div class="container-narrow text-center">
      <p class="text-eyebrow mb-4">Gallery</p>
      <h1 class="heading-1 mb-6">
        Community life<br />in pictures.
      </h1>
      <p class="text-body mx-auto max-w-2xl">
        Moments from our Bible study, Korean class, youth events, and community
        gatherings in Sandton, Johannesburg. These images give you a sense of
        who shows up and what we do together.
      </p>
    </div>
  </section>

  <!-- Category filter (visual) -->
  <section class="section-tighter">
    <div class="container-max">
      <div class="flex flex-wrap gap-3 mb-12">
        {categories.map((cat) => (
          <span class={`text-xs font-medium px-4 py-2 rounded-full transition-colors ${cat === 'All' ? 'bg-[color:var(--color-ink)] text-white' : 'bg-white text-gray-600 border border-gray-200 hover:border-[color:var(--color-warm)]'}`}>
            {cat}
          </span>
        ))}
      </div>

      <!-- Editorial masonry-ish grid -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {images.map((img, idx) => (
          <article class={`card-image overflow-hidden group ${idx === 0 ? 'lg:row-span-2 lg:col-span-1' : ''}`}>
            <div class={`overflow-hidden ${idx === 0 ? 'aspect-[3/4]' : 'aspect-[4/3]'}`}>
              <img
                src={img.src}
                alt={img.alt}
                class="img-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs uppercase tracking-widest text-[color:var(--color-warm)] font-semibold">
                  {img.category}
                </span>
              </div>
              <h3 class="heading-3 mb-2 text-lg">{img.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{img.caption}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA strip -->
  <section class="section-padding section-cream">
    <div class="container-narrow text-center">
      <p class="text-eyebrow mb-3">Be part of the next one</p>
      <h2 class="heading-2 mb-4">Our community grows one Wednesday at a time.</h2>
      <p class="text-body mx-auto mb-6 max-w-xl">
        Real photos are added as the moments happen — until then, these images
        capture the spirit of what we do.
      </p>
      <a href="/visit" class="btn-primary">Plan Your Visit</a>
    </div>
  </section>
</BaseLayout>
