<script define:vars={{ hymns }}>
  // ==========================================
  // Language Filter
  // ==========================================
  const filterButtons = document.querySelectorAll('.lang-filter');
  const hymnCards = document.querySelectorAll('.hymn-card');
  const noResults = document.getElementById('no-results');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const lang = button.getAttribute('data-lang');
      
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-amber-500', 'text-white', 'shadow-lg');
        btn.classList.add('bg-slate-100', 'text-slate-700');
      });
      button.classList.remove('bg-slate-100', 'text-slate-700');
      button.classList.add('bg-amber-500', 'text-white', 'shadow-lg');
      
      let visibleCount = 0;
      hymnCards.forEach((card, index) => {
        const cardLang = card.getAttribute('data-language');
        const htmlCard = card;
        
        if (lang === 'all' || cardLang === lang) {
          htmlCard.style.display = 'block';
          htmlCard.style.animation = `fadeInUp 0.4s ease ${index * 0.05}s both`;
          visibleCount++;
        } else {
          htmlCard.style.display = 'none';
        }
      });
      
      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    });
  });

  const allButton = document.querySelector('[data-lang="all"]');
  if (allButton) {
    allButton.classList.remove('bg-slate-100', 'text-slate-700');
    allButton.classList.add('bg-amber-500', 'text-white', 'shadow-lg');
  }
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Volume slider styling */
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    background: white;
    border-radius: 50%;
    cursor: pointer;
  }
  
  input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    background: white;
    border-radius: 50%;
    cursor: pointer;
    border: none;
  }
</style>
