---

<BaseLayout
  title="Hymns & Worship Songs | Johannesburg Bible Study Church"
  description="Praise and worship songs in 17 languages — Zulu, Xhosa, Sotho, Tswana, Pedi, Ndebele, Afrikaans, Swahili, Dinka, Shona, Lingala, Igbo, Yoruba, Amharic, English, and Korean. Download chord sheets."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1509099836639-18ba1795216d?w=1600&q=80"
        alt="African worship community"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/95 via-slate-900/85 to-slate-900/70"></div>
    </div>
    
    <div class="absolute inset-0 z-10 opacity-10" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22><path fill=%22%23f4e4bc%22 d=%22M0 0h40v40H0zM40 40h40v40H40z%22/><path fill=%22%23c9a227%22 d=%22M20 20h20v20H20z%22/></svg>'); background-size: 40px 40px;"></div>
    
    <div class="relative z-20 section-padding py-24 md:py-32">
      <div class="container-max">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 text-amber-200/80 text-sm mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span>/</span>
            <span class="text-white">Hymns & Worship</span>
          </div>
          
          <p class="text-amber-400 font-semibold uppercase tracking-wider text-sm mb-3">
            Praise & Worship
          </p>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Hymns & <span class="text-amber-400">Worship Songs</span>
          </h1>
          
          <p class="text-xl text-slate-200 mb-8 max-w-2xl leading-relaxed">
            Our community worships in many languages. From the hills of KwaZulu-Natal to the plains of South Sudan, 
            we raise our voices together in praise.
          </p>
          
          <div class="flex flex-wrap gap-8 mb-10">
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">{hymns.length}</p>
              <p class="text-sm text-slate-300">Songs</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">17</p>
              <p class="text-sm text-slate-300">Languages</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">Free</p>
              <p class="text-sm text-slate-300">Downloads</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 100L60 90C120 80 240 60 360 50C480 40 600 40 720 45C840 50 960 60 1080 65C1200 70 1320 70 1380 70L1440 70V100H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Audio Coming Soon -->
  <section class="bg-gradient-to-r from-amber-600 to-orange-600 py-4 shadow-lg">
    <div class="container-max">
      <div class="flex items-center justify-center gap-3 text-white">
        <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        <p class="text-sm">
          <strong>Background music coming soon!</strong> We're preparing soft piano worship tracks for you.
        </p>
      </div>
    </div>
  </section>

  <!-- Language Filter -->
  <section class="section-padding bg-white">
    <div class="container-max">
      <div class="text-center mb-8">
        <h2 class="heading-2 mb-3">Browse by Language</h2>
        <p class="text-gray-600">Select a language to filter hymns</p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-3">
        {languages.map((lang) => (
          <button 
            class="lang-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200
                   bg-slate-100 text-slate-700 hover:bg-amber-500 hover:text-white hover:shadow-lg hover:-translate-y-0.5"
            data-lang={lang.code}
          >
            {lang.name}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Hymns Grid -->
  <section class="section-padding bg-gradient-to-b from-slate-50 to-white">
    <div class="container-max">
      <div id="hymns-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {hymns.map((hymn) => {
          const imageUrl = hymn.image || regionImages[hymn.region] || regionImages['Global / South Africa'];
          return (
            <article 
              class="hymn-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              data-language={hymn.language}
            >
              <div class="relative h-48 overflow-hidden">
                <img 
                  src={imageUrl}
                  alt={`${hymn.title} - ${hymn.region}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
                
                <div class="absolute top-4 left-4">
                  <span class="inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-sm text-slate-800 px-3 py-1.5 rounded-full text-xs font-semibold shadow-sm">
                    <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                    </svg>
                    {hymn.languageName}
                  </span>
                </div>
                
                <div class="absolute top-4 right-4">
                  <span class="bg-amber-500/90 backdrop-blur-sm text-white px-2.5 py-1 rounded-full text-xs font-bold shadow-sm">
                    Key: {hymn.key}
                  </span>
                </div>
              </div>
              
              <div class="p-5">
                <h3 class="text-xl font-bold text-slate-800 mb-1 group-hover:text-amber-600 transition-colors">
                  {hymn.title}
                </h3>
                
                {hymn.alternateTitle && (
                  <p class="text-sm text-amber-600 font-medium mb-3">{hymn.alternateTitle}</p>
                )}
                
                <p class="text-sm text-slate-600 mb-4 line-clamp-3 leading-relaxed">{hymn.excerpt}</p>
                
                <div class="flex items-center gap-2 text-xs text-slate-500 mb-4">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {hymn.region}
                </div>
                
                <div class="bg-slate-50 rounded-lg px-3 py-2 mb-4">
                  <p class="text-xs text-slate-500 mb-1">Chord Progression</p>
                  <p class="text-sm font-mono font-semibold text-slate-700">{hymn.chords}</p>
                </div>
                
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {hymn.tags.filter(t => t !== 'hymn' && t !== hymn.language).map((tag) => (
                    <span class="text-xs bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full font-medium">{tag}</span>
                  ))}
                </div>
                
                <div class="flex gap-3 pt-4 border-t border-slate-100">
                  <a 
                    href={`/blog/${hymn.slug}`}
                    class="flex-1 inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    View Lyrics
                  </a>
                  <a 
                    href={`/hymns/${hymn.slug}.docx`}
                    class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors"
                    download
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    .docx
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      
