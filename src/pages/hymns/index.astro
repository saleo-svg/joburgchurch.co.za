---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { hymns, languages } from '@/data/hymns.ts';

// Region fallback image map — cross / Jesus / worship themes.
// Each region maps to a different cross-themed photo so regions don't
// all share the same wallpaper.
const img = (id: string) => `https://images.unsplash.com/photo-${id}?w=800&q=80`;
const regionImages: Record<string, string> = {
  // Cross silhouettes against sky
  'Global / South Africa': img('1450558415837-1f5e21a17709'), // cross silhouette orange sky
  'KwaZulu-Natal, South Africa': img('1617610882105-71c5d7447837'), // cross silhouette sunset
  'Gauteng, South Africa': img('1528825539566-2bcb5882445c'), // cross silhouette mountain golden hour
  'Eastern Cape, South Africa': img('1594387295585-34ba732932c8'), // cross silhouette Rio sunset
  'Western Cape, South Africa': img('1607947243050-93d773ede731'), // cross silhouette France dusk
  'Free State, South Africa': img('1617099331324-5ff9fb59578c'), // red cross neon dark
  'North West, South Africa': img('1571851636055-255e91e36c3f'), // cross lit up dark
  'Limpopo, South Africa': img('1637480054684-7ffd1996fc9c'), // statue of Jesus on cross
  'Mpumalanga, South Africa': img('1617099331324-5ff9fb59578c'),
  'Lesotho': img('1528825539566-2bcb5882445c'),
  'Lesotho / Free State, South Africa': img('1607947243050-93d773ede731'),
  'Botswana': img('1617610882105-71c5d7447837'),
  'Botswana / North West SA': img('1450558415837-1f5e21a17709'),

  // Worship / hands raised
  'East Africa / Kenya': img('1775400713633-e4b2b3577fb7'), // hands raised worship
  'Kenya': img('1769755410096-6c7a85d13f86'), // hands raised worship group
  'Tanzania': img('1762013728522-f97f83565373'), // woman hands raised prayer
  'Tanzania / Kenya': img('1775400713633-e4b2b3577fb7'),
  'Uganda': img('1769755410096-6c7a85d13f86'),
  'South Sudan': img('1571851636055-255e91e36c3f'),
  'Zimbabwe': img('1775400713633-e4b2b3577fb7'),
  'Democratic Republic of Congo': img('1762013728522-f97f83565373'),
  'DRC / Congo': img('1769755410096-6c7a85d13f86'),
  'Republic of Congo': img('1775400713633-e4b2b3577fb7'),
  'Nigeria': img('1769755410096-6c7a85d13f86'),
  'Ethiopia': img('1617099331324-5ff9fb59578c'),
  'Ethiopia / Eritrea': img('1637480054684-7ffd1996fc9c'),
  'Korea': img('1650658986628-1d91731f046e'), // stained glass window
  'Korea / Johannesburg Korean Community': img('1739878599996-fbed899de1b0'), // sunlight through church windows
  'Seoul, Korea': img('1739834728302-a67c905da6fb'), // gothic church window
  'South Sudan / Diaspora': img('1571851636055-255e91e36c3f'),

  // Bible / church light
  'USA / Global': img('1480721145676-f5c40929d80c'), // opened bible bokeh
  'UK / Global': img('1536063766742-b514ee70707f'), // bible in window light
  'Australia / Global': img('1739878599996-fbed899de1b0'),

  // Stained glass & candles
  'South Africa / Afrikaans': img('1750688468246-4679eaea864b'), // tall church window purple
  'South Africa / Dutch Reformed': img('1739834728302-a67c905da6fb'),
  'South Africa / Afrikaans Reformed': img('1650658986628-1d91731f046e'),
  'South Africa / Afrikaans revival': img('1766686609656-a8be9681047d'), // candles in dark church
};

// Number of hymns with a YouTube link or video id (shown in the hero stats)
const youtubeHitsCount = hymns.filter(h => h.youtubeId || h.youtubeSearch).length;
---


<BaseLayout
  title="Hymns & Worship Songs | Johannesburg Bible Study Church"
  description="Praise and worship songs in 17 languages 鈥?Zulu, Xhosa, Sotho, Tswana, Pedi, Ndebele, Afrikaans, Swahili, Dinka, Shona, Lingala, Igbo, Yoruba, Amharic, English, and Korean. Includes popular songs from YouTube, Instagram, and X.com trends. Free downloads."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1509099836639-18ba1795216d?w=1600&q=80"
        alt="African worship community"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-900/95 via-slate-900/85 to-slate-900/70"></div>
    </div>
    
    <div class="absolute inset-0 z-10 opacity-10" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22><path fill=%22%23f4e4bc%22 d=%22M0 0h40v40H0zM40 40h40v40H40z%22/><path fill=%22%23c9a227%22 d=%22M20 20h20v20H20z%22/></svg>'); background-size: 40px 40px;"></div>
    
    <div class="relative z-20 section-padding py-24 md:py-32">
      <div class="container-max">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 text-amber-200/80 text-sm mb-6">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span>/</span>
            <span class="text-white">Hymns & Worship</span>
          </div>
          
          <p class="text-amber-400 font-semibold uppercase tracking-wider text-sm mb-3">
            Praise & Worship
          </p>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            Hymns & <span class="text-amber-400">Worship Songs</span>
          </h1>
          
          <p class="text-xl text-slate-200 mb-8 max-w-2xl leading-relaxed">
            Our community worships in many languages. From the hills of KwaZulu-Natal to the plains of South Sudan, 
            we raise our voices together in praise.
          </p>
          
          <div class="flex flex-wrap gap-8 mb-10">
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">{hymns.length}</p>
              <p class="text-sm text-slate-300">Songs</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">{languages.length - 1}</p>
              <p class="text-sm text-slate-300">Languages</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">Free</p>
              <p class="text-sm text-slate-300">Downloads</p>
            </div>
            <div class="text-center">
              <p class="text-3xl font-bold text-amber-400">{youtubeHitsCount}+</p>
              <p class="text-sm text-slate-300">YouTube & Social Hits</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="absolute bottom-0 left-0 right-0 z-20">
      <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
        <path d="M0 100L60 90C120 80 240 60 360 50C480 40 600 40 720 45C840 50 960 60 1080 65C1200 70 1320 70 1380 70L1440 70V100H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Audio Coming Soon -->
  <section class="bg-gradient-to-r from-amber-600 to-orange-600 py-4 shadow-lg">
    <div class="container-max">
      <div class="flex items-center justify-center gap-3 text-white">
        <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        <p class="text-sm">
          <strong>Background music coming soon!</strong> We're preparing soft piano worship tracks for you.
        </p>
      </div>
    </div>
  </section>

  <!-- Language Filter -->
  <section class="section-padding bg-white">
    <div class="container-max">
      <div class="text-center mb-8">
        <h2 class="heading-2 mb-3">Browse by Language</h2>
        <p class="text-gray-600">Select a language to filter hymns</p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-3">
        {languages.map((lang) => (
          <button 
            class="lang-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200
                   bg-slate-100 text-slate-700 hover:bg-amber-500 hover:text-white hover:shadow-lg hover:-translate-y-0.5"
            data-lang={lang.code}
          >
            {lang.name}
          </button>
        ))}
        <button 
          class="popular-filter px-4 py-2 rounded-full text-sm font-medium transition-all duration-200
                 bg-gradient-to-r from-red-500 to-orange-500 text-white hover:shadow-lg hover:-translate-y-0.5"
          data-popular="true"
        >
          <svg class="w-3.5 h-3.5 inline-block mr-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Popular on Social
        </button>
      </div>
    </div>
  </section>

  <!-- Hymns Grid -->
  <section class="section-padding bg-gradient-to-b from-slate-50 to-white">
    <div class="container-max">
      <div id="hymns-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {hymns.map((hymn) => {
          const imageUrl = hymn.image || regionImages[hymn.region] || regionImages['Global / South Africa'];
          return (
            <article 
              class="hymn-card group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
              data-language={hymn.language}
              data-popular={hymn.popularity ? 'true' : 'false'}
            >
              <div class="relative h-48 overflow-hidden">
                <img 
                  src={imageUrl}
                  alt={`${hymn.title} - ${hymn.region}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
                
                <div class="absolute top-4 left-4">
                  <span class="inline-flex items-center gap-1.5 bg-white/95 backdrop-blur-sm text-slate-800 px-3 py-1.5 rounded-full text-xs font-semibold shadow-sm">
                    <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                    </svg>
                    {hymn.languageName}
                  </span>
                </div>
                
                <div class="absolute top-4 right-4">
                  <span class="bg-amber-500/90 backdrop-blur-sm text-white px-2.5 py-1 rounded-full text-xs font-bold shadow-sm">
                    Key: {hymn.key}
                  </span>
                </div>
                
                {hymn.popularity && (
                  <div class="absolute bottom-4 right-4">
                    <span class="inline-flex items-center gap-1 bg-red-600/95 backdrop-blur-sm text-white px-2.5 py-1 rounded-full text-xs font-bold shadow-sm">
                      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                      </svg>
                      Popular
                    </span>
                  </div>
                )}
              </div>
              
              <div class="p-5">
                <h3 class="text-xl font-bold text-slate-800 mb-1 group-hover:text-amber-600 transition-colors">
                  {hymn.title}
                </h3>
                
                {hymn.alternateTitle && (
                  <p class="text-sm text-amber-600 font-medium mb-3">{hymn.alternateTitle}</p>
                )}
                
                <p class="text-sm text-slate-600 mb-4 line-clamp-3 leading-relaxed">{hymn.excerpt}</p>
                
                {hymn.popularity && (
                  <div class="flex items-center gap-1.5 text-xs text-slate-700 bg-gradient-to-r from-red-50 to-orange-50 border border-red-100 rounded-lg px-3 py-2 mb-4">
                    <svg class="w-3.5 h-3.5 text-red-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    <span class="font-medium text-slate-800">{hymn.popularity}</span>
                  </div>
                )}
                
                <div class="flex items-center gap-2 text-xs text-slate-500 mb-4">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {hymn.region}
                </div>
                
                <div class="bg-slate-50 rounded-lg px-3 py-2 mb-4">
                  <p class="text-xs text-slate-500 mb-1">Chord Progression</p>
                  <p class="text-sm font-mono font-semibold text-slate-700">{hymn.chords}</p>
                </div>
                
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {hymn.tags.filter(t => t !== 'hymn' && t !== hymn.language).map((tag) => (
                    <span class="text-xs bg-amber-50 text-amber-700 px-2 py-0.5 rounded-full font-medium">{tag}</span>
                  ))}
                </div>
                
                <div class="flex flex-wrap gap-3 pt-4 border-t border-slate-100">
                  <a
                    href={`/hymns/${hymn.slug}/`}
                    class="flex-1 inline-flex items-center justify-center gap-2 bg-slate-800 hover:bg-slate-700 text-white px-4 py-2.5 rounded-lg text-sm font-medium transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    View Lyrics
                  </a>
                  <a
                    href={`https://www.youtube.com/results?search_query=${encodeURIComponent((hymn.youtubeSearch || hymn.title + ' ' + (hymn.artist || '')).trim())}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Watch on YouTube"
                    class="inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white px-3 py-2.5 rounded-lg text-sm font-medium transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                  </a>
                  <a
                    href={`/hymns/${hymn.slug}.docx`}
                    class="inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white px-3 py-2.5 rounded-lg text-sm font-medium transition-colors"
                    download
                    title="Download .docx"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      
      <p id="no-results" class="hidden text-center text-gray-500 py-16">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
        </svg>
        No hymns found for this language.<br/>
        <button onclick="document.querySelector('[data-lang=all]').click()" class="text-blue-600 hover:underline mt-2">View all hymns</button>
      </p>
    </div>
  </section>

  <!-- Community Section -->
  <section class="section-padding bg-gradient-to-br from-amber-50 via-orange-50 to-amber-50 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-amber-200/30 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-orange-200/20 rounded-full blur-3xl"></div>
    
    <div class="container-max relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-800 px-4 py-2 rounded-full text-sm font-medium mb-6">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          Share Your Worship
        </div>
        
        <h2 class="heading-1 mb-6">Add Your Voice to Our Collection</h2>
        
        <p class="text-lg text-slate-700 mb-8 max-w-2xl mx-auto leading-relaxed">
          Do you have lyrics or chord sheets in your language? Whether it's Pedi, Tswana, Ndebele, 
          or any other language spoken in our Johannesburg community 鈥?we'd love to add your songs.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-white px-8 py-4 rounded-xl text-lg font-semibold transition-all hover:-translate-y-0.5 hover:shadow-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Contact Us
          </a>
          <a href="/blog" class="inline-flex items-center gap-2 bg-white hover:bg-slate-50 text-slate-800 px-8 py-4 rounded-xl text-lg font-semibold border-2 border-slate-200 transition-all hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Read Our Blog
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ hymns }}>
  // ==========================================
  // Language Filter
  // ==========================================
  const filterButtons = document.querySelectorAll('.lang-filter');
  const popularButton = document.querySelector('.popular-filter');
  const hymnCards = document.querySelectorAll('.hymn-card');
  const noResults = document.getElementById('no-results');
  let currentFilter = 'all';

  function resetAllButtonStyles() {
    filterButtons.forEach(btn => {
      btn.classList.remove('bg-amber-500', 'text-white', 'shadow-lg');
      btn.classList.add('bg-slate-100', 'text-slate-700');
    });
    if (popularButton) {
      popularButton.classList.remove('ring-2', 'ring-white', 'shadow-2xl', 'scale-105');
    }
  }

  function applyFilter() {
    let visibleCount = 0;
    hymnCards.forEach((card, index) => {
      const cardLang = card.getAttribute('data-language');
      const isPopular = card.getAttribute('data-popular') === 'true';
      
      let shouldShow = false;
      if (currentFilter === 'popular') {
        shouldShow = isPopular;
      } else if (currentFilter === 'all') {
        shouldShow = true;
      } else {
        shouldShow = cardLang === currentFilter;
      }
      
      if (shouldShow) {
        card.style.display = 'block';
        card.style.animation = `fadeInUp 0.4s ease ${index * 0.03}s both`;
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });
    
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount > 0);
    }
  }

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      currentFilter = button.getAttribute('data-lang');
      resetAllButtonStyles();
      button.classList.remove('bg-slate-100', 'text-slate-700');
      button.classList.add('bg-amber-500', 'text-white', 'shadow-lg');
      applyFilter();
    });
  });

  if (popularButton) {
    popularButton.addEventListener('click', () => {
      currentFilter = 'popular';
      resetAllButtonStyles();
      popularButton.classList.add('ring-2', 'ring-white', 'shadow-2xl', 'scale-105');
      applyFilter();
    });
  }

  const allButton = document.querySelector('[data-lang="all"]');
  if (allButton) {
    allButton.classList.remove('bg-slate-100', 'text-slate-700');
    allButton.classList.add('bg-amber-500', 'text-white', 'shadow-lg');
  }
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
