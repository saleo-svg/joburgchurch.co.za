---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Share from '@/components/Share.astro';
import { getChurchSchema } from '@/components/Schema';

const schema = getChurchSchema({
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Wednesday'],
      opens: '19:30',
      closes: '21:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday'],
      opens: '14:00',
      closes: '16:00',
    },
  ],
});

/* Real photography from Unsplash — public Unsplash License */
const heroPhoto = 'https://images.unsplash.com/photo-1529070538774-1843cb3265df?w=1600&q=80&auto=format&fit=crop';
const koreanPhoto = 'https://images.unsplash.com/photo-1543269865-cbf427effbad?w=1200&q=80&auto=format&fit=crop';
const youthPhoto = 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=1200&q=80&auto=format&fit=crop';
const communityPhoto = 'https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=1600&q=80&auto=format&fit=crop';
---

<BaseLayout
  title="Johannesburg Bible Study Church | A Bible Study Community in Sandton"
  description="Join a welcoming Bible study and Christian community in Sandton, Johannesburg. Wednesday online Bible study, free Sunday Korean class, spiritual education, youth programs, and community activities."
  schema={schema}
>
  <!-- ============================================================ -->
  <!-- HERO · full-bleed image, serif headline, breathing space     -->
  <!-- ============================================================ -->
  <section class="relative isolate overflow-hidden bg-white">
    <div class="absolute inset-0 -z-10">
      <img
        src={heroPhoto}
        alt="People gathered around a table for Bible study"
        class="h-full w-full object-cover opacity-30"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-white/70 to-white"></div>
    </div>

    <div class="container-narrow section-padding text-center">
      <p class="text-eyebrow mb-6">A Bible study community · Sandton · Johannesburg</p>
      <h1 class="heading-1 mb-8">
        Where Johannesburg<br />reads the Bible together.
      </h1>
      <p class="text-body mx-auto max-w-2xl mb-10 text-lg">
        Wednesday evenings online. Sunday afternoons in person. A welcoming Christian
        community in Parkmore, Sandton — for anyone curious enough to show up.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/visit" class="btn-primary">Plan Your Visit</a>
        <a href="/spiritual-education" class="btn-secondary">About Bible Study</a>
      </div>
      <p class="mt-10 text-sm text-gray-500">
        <span class="font-semibold text-gray-700">This Wednesday</span> ·
        <a href="/visit" class="text-[color:var(--color-warm)] hover:underline">Exodus 14: The Sea That Parts · 7:30pm</a>
      </p>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- SCRIPTURE QUOTE · serif, full-width, breathing               -->
  <!-- ============================================================ -->
  <section class="section-padding section-cream">
    <div class="container-narrow text-center">
      <p class="text-eyebrow mb-8">From this week's passage</p>
      <blockquote>
        <p class="scripture-quote">
          &ldquo;The LORD will fight for you; you need only to be still.&rdquo;
        </p>
        <p class="scripture-ref">— Exodus 14:14</p>
      </blockquote>
      <div class="mt-10">
        <a href="/spiritual-education" class="btn-warm">Join the Wednesday Study</a>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- THREE WAYS · image-forward, asymmetric                      -->
  <!-- ============================================================ -->
  <section class="section-padding">
    <div class="container-max">
      <div class="mb-16 max-w-2xl">
        <p class="text-eyebrow mb-3">Three ways to belong</p>
        <h2 class="heading-2 mb-4">Showing up is the first step.</h2>
        <p class="text-body">
          Bible study on Wednesday, a free Korean class on Sunday, and a youth
          community that runs seasonal — choose one. Showing up is the only
          requirement.
        </p>
      </div>

      <div class="grid gap-10 lg:grid-cols-2">
        <!-- Big card: Bible study -->
        <article class="card-image group relative overflow-hidden">
          <div class="aspect-[5/4] overflow-hidden">
            <img
              src={heroPhoto}
              alt="People in a small Bible study group"
              class="img-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-8">
            <p class="text-eyebrow mb-2">Bible Study</p>
            <h3 class="heading-3 mb-3">Wednesday evenings, online.</h3>
            <p class="text-body mb-6">
              7:30pm on Google Meet. Read the same passage. Ask the question you
              have been sitting with. An open room for beginners and long-time
              students alike.
            </p>
            <a href="/spiritual-education" class="text-sm font-semibold text-[color:var(--color-primary)] hover:underline">
              Learn about Bible Study →
            </a>
          </div>
        </article>

        <!-- Smaller cards stacked -->
        <div class="flex flex-col gap-10">
          <article class="card-image group relative overflow-hidden">
            <div class="aspect-[5/3] overflow-hidden">
              <img
                src={koreanPhoto}
                alt="Students in a Korean language class"
                class="img-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-8">
              <p class="text-eyebrow mb-2">Korean Class</p>
              <h3 class="heading-3 mb-3">Sundays at 2pm in Parkmore.</h3>
              <p class="text-body mb-6">
                A free Korean class for the Johannesburg community. Beginners
                welcome. The Hangul alphabet on day one; a restaurant menu by
                the end of the session.
              </p>
              <a href="/community-classes/korean" class="text-sm font-semibold text-[color:var(--color-primary)] hover:underline">
                See the Korean Class →
              </a>
            </div>
          </article>

          <article class="card-image group relative overflow-hidden">
            <div class="aspect-[5/3] overflow-hidden">
              <img
                src={youthPhoto}
                alt="Young people at a youth camp outdoors"
                class="img-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-8">
              <p class="text-eyebrow mb-2">Youth Programs</p>
              <h3 class="heading-3 mb-3">UseCan, in summer and winter.</h3>
              <p class="text-body mb-6">
                Seasonal camps and leadership development for young people in
                Johannesburg. Service, growth, and good company.
              </p>
              <a href="/youth-usecan" class="text-sm font-semibold text-[color:var(--color-primary)] hover:underline">
                Youth Programs →
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- ABOUT · photo left, text right                                -->
  <!-- ============================================================ -->
  <section class="section-padding section-cream">
    <div class="container-max">
      <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <div class="relative overflow-hidden rounded-lg">
          <img
            src={communityPhoto}
            alt="Johannesburg Bible Study Church community gathering"
            class="aspect-[5/6] w-full img-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <p class="text-eyebrow mb-3">About</p>
          <h2 class="heading-2 mb-6">A welcoming community in Sandton.</h2>
          <p class="text-body mb-6">
            Johannesburg Bible Study Church is a Bible-centred community in
            Parkmore, Sandton. We gather online on Wednesday evenings, offer a
            free Korean class on Sundays, and run youth programs through the
            year — all open to everyone in the greater Johannesburg area, with
            no church membership required.
          </p>
          <dl class="mb-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-gray-300 pt-6">
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-500">Where</dt>
              <dd class="font-serif text-lg text-gray-900">Parkmore, Sandton</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-500">When</dt>
              <dd class="font-serif text-lg text-gray-900">Wed 7:30pm · Sun 2pm</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-500">Cost</dt>
              <dd class="font-serif text-lg text-gray-900">Free, always</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-widest text-gray-500">Membership</dt>
              <dd class="font-serif text-lg text-gray-900">None required</dd>
            </div>
          </dl>
          <a href="/about" class="btn-primary">Our Story</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- VOICES · Three testimonials                                   -->
  <!-- ============================================================ -->
  <section class="section-padding">
    <div class="container-max">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <p class="text-eyebrow mb-3">Voices from the Bible Study</p>
        <h2 class="heading-2 mb-4">What people in the room say.</h2>
        <p class="text-body">
          Honest, lightly edited, with permission. Most of these come from
          people who searched "Bible study near me Johannesburg", showed up
          once, and are still here two years later.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-3">
        <figure class="card">
          <blockquote class="text-base leading-relaxed text-gray-700">
            <p class="font-serif text-lg leading-snug text-gray-900">
              I came to one Wednesday expecting to feel like an outsider. By the
              end of the evening, two people from Randburg had offered me a
              lift to the next one.
            </p>
          </blockquote>
          <figcaption class="mt-6 border-t border-gray-100 pt-5">
            <p class="font-semibold text-gray-900">— Lerato M.</p>
            <p class="text-sm text-gray-500">Sandton, joined 2023</p>
          </figcaption>
        </figure>
        <figure class="card">
          <blockquote class="text-base leading-relaxed text-gray-700">
            <p class="font-serif text-lg leading-snug text-gray-900">
              I moved here from Cape Town for a new job and did not know a soul.
              The Sunday Korean class in Sandton became my soft landing. I now
              have actual friends in the city.
            </p>
          </blockquote>
          <figcaption class="mt-6 border-t border-gray-100 pt-5">
            <p class="font-semibold text-gray-900">— David K.</p>
            <p class="text-sm text-gray-500">Parkmore, joined 2024</p>
          </figcaption>
        </figure>
        <figure class="card">
          <blockquote class="text-base leading-relaxed text-gray-700">
            <p class="font-serif text-lg leading-snug text-gray-900">
              I had not opened a Bible since school. The second Wednesday, I
              asked a question about Exodus that I had been sitting with for a
              month. Mr. Sim treated it like the most important question.
            </p>
          </blockquote>
          <figcaption class="mt-6 border-t border-gray-100 pt-5">
            <p class="font-semibold text-gray-900">— Sarah P.</p>
            <p class="text-sm text-gray-500">Randburg, joined 2025</p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- NEW HERE · 3 steps                                           -->
  <!-- ============================================================ -->
  <section class="section-padding section-warm">
    <div class="container-max">
      <div class="grid items-start gap-12 lg:grid-cols-[1fr_1.3fr]">
        <div>
          <p class="text-eyebrow mb-3">New here?</p>
          <h2 class="heading-2 mb-5">A simple way to start.</h2>
          <p class="text-body mb-6">
            Many people find us while searching for Bible study in
            Johannesburg, church in Sandton, or a friendly Christian community
            nearby. You do not need to know everything before joining. A phone
            call is enough.
          </p>
          <a href="/contact" class="btn-primary">Get in Touch</a>
        </div>
        <div class="grid gap-6 sm:grid-cols-3">
          <div class="card">
            <p class="font-serif text-3xl text-[color:var(--color-warm)] mb-3">01</p>
            <h3 class="heading-3 mb-2">Choose</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Bible study on Wednesday or the free Korean class on Sunday.
              Either one is a fine place to start.
            </p>
          </div>
          <div class="card">
            <p class="font-serif text-3xl text-[color:var(--color-warm)] mb-3">02</p>
            <h3 class="heading-3 mb-2">Call</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Call Mr. Sim or Ms. Dora for the meeting link, directions, or to
              register for the Korean class.
            </p>
          </div>
          <div class="card">
            <p class="font-serif text-3xl text-[color:var(--color-warm)] mb-3">03</p>
            <h3 class="heading-3 mb-2">Show up</h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Visitors, beginners, students, families, and people exploring
              faith are welcome. As you are.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================ -->
  <!-- BLOG · CTA strip                                              -->
  <!-- ============================================================ -->
  <section class="section-padding">
    <div class="container-narrow text-center">
      <p class="text-eyebrow mb-3">From our community</p>
      <h2 class="heading-2 mb-5">Articles on Bible study, community, and faith.</h2>
      <p class="text-body mx-auto mb-8 max-w-2xl">
        Long-form writing from the people who show up on Wednesdays and Sundays
        in Sandton.
      </p>
      <a href="/blog" class="btn-secondary">Read the Blog</a>
    </div>
  </section>

  <!-- Share strip — last CTA before footer -->
  <section class="section-tighter border-t border-gray-200">
    <div class="container-narrow text-center">
      <p class="text-eyebrow mb-4">Found this useful?</p>
      <p class="text-body mb-6 max-w-xl mx-auto">
        If someone you know would value a Bible study community in Sandton,
        send it their way.
      </p>
      <div class="flex justify-center">
        <Share title="Johannesburg Bible Study Church — A Bible Study Community in Sandton" align="center" />
      </div>
    </div>
  </section>
</BaseLayout>
