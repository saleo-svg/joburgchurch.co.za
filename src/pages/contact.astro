---
import BaseLayout from '@/layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];
---

<BaseLayout
  title="Contact Johannesburg Bible Study Church | Phone & WhatsApp"
  description="Contact Johannesburg Bible Study Church in Sandton, Johannesburg. Call +27 77 487 1295 (Mr. Sim) or WhatsApp +27 67 442 4461 (Ms. Dora) to join Bible study, register for Korean class, or make enquiries."
  breadcrumbs={breadcrumbs}
>
  <section class="section-padding">
    <div class="container-max">
      <h1 class="heading-1 mb-6">Contact Us</h1>
      <p class="text-body max-w-2xl mb-12">
        For enquiries about our Wednesday Bible study, Korean language class, youth programs, or anything else — please reach us by phone.
      </p>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="heading-2 mb-8">Get In Touch</h2>

          <div class="space-y-6 mb-8">
            <div class="flex gap-4">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-blue-100 text-blue-700 font-bold shrink-0">P</div>
              <div>
                <p class="font-semibold text-gray-900 mb-1">Phone</p>
                <p class="text-sm text-gray-600">Please call us for all enquiries including Bible study, Korean class registration, and youth programs.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-amber-100 text-amber-700 font-bold shrink-0">KC</div>
              <div>
                <p class="font-semibold text-gray-900 mb-1">Korean Class Hotline</p>
                <p class="text-sm text-gray-600">Appointments required for Korean class. Please call to register before attending.</p>
              </div>
            </div>
          </div>

          <!-- Phone Numbers -->
          <h3 class="heading-3 mb-4">Phone Numbers</h3>
          <div class="card space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-500 mb-1">Mr. Leo</p>
                <a href="tel:+27792592607" class="text-xl font-bold text-blue-700 hover:underline">+27 79 259 2607</a>
              </div>
              <a
                href="https://wa.me/27792592607"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#25D366] hover:bg-[#20BD5A] text-white font-semibold rounded-lg transition-colors shadow-md hover:shadow-lg"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
              </a>
            </div>
            <div class="border-t border-gray-200 pt-6 flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-500 mb-1">Mr. Sim</p>
                <a href="tel:+27774871295" class="text-xl font-bold text-blue-700 hover:underline">+27 77 487 1295</a>
              </div>
              <a 
                href="https://wa.me/27774871295" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#25D366] hover:bg-[#20BD5A] text-white font-semibold rounded-lg transition-colors shadow-md hover:shadow-lg"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
