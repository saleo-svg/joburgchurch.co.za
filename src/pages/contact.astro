                </svg>
                WhatsApp
              </a>
            </div>
            <div class="border-t border-gray-200 pt-6 flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-500 mb-1">Ms. Dora</p>
                <a href="tel:+27674424461" class="text-xl font-bold text-blue-700 hover:underline">+27 67 442 4461</a>
              </div>
              <a 
                href="https://wa.me/27674424461" 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#25D366] hover:bg-[#20BD5A] text-white font-semibold rounded-lg transition-colors shadow-md hover:shadow-lg"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
              </a>
            </div>
          </div>
        </div>

        <div>
          <h2 class="heading-2 mb-8">Frequently Asked Questions</h2><h2 class="heading-2 mb-8">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {[
              {
                q: 'How do I join the Wednesday Bible study?',
                a: 'Our Wednesday Bible study is held online at 7:30pm via Google Meet. Contact us by phone and we will send you the meeting link.',
              },
              {
                q: 'How do I register for the Korean class?',
                a: 'Appointments are required for the Korean class. A course fee applies — please call Mr. Sim (+27 77 487 1295) or Ms. Dora (+27 67 442 4461) to confirm current fees and register before attending.',
              },
              {
                q: 'Do I need to be a church member to attend classes?',
                a: 'No. Our Bible study and community classes are open to everyone in the Johannesburg and Sandton community.',
              },
              {
                q: 'Is there parking available?',
                a: 'Our venue is in Parkmore, Sandton. Parking availability varies — please contact us for specific directions.',
              },
              {
                q: 'Can I speak to someone about faith or personal matters?',
                a: 'Yes. Please call us and we will connect you with a leader who can speak with you personally.',
              },
            ].map((faq) => (
              <div class="card">
                <h3 class="font-semibold text-gray-900 mb-2">{faq.q}</h3>
                <p class="text-sm text-gray-600">{faq.a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
