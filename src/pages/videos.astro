---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Recent Studies', url: '/videos/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Recent Bible Study Series & Sermon Notes — Sandton',
  description:
    'Written recaps of recent Wednesday Bible study series, sermon notes, and community moments from Johannesburg Bible Study Church in Sandton, Johannesburg.',
  url: 'https://joburgchurch.co.za/videos/',
};

type StudyEntry = {
  id: string;
  title: string;
  description: string;
  category: string;
  duration: string;
  date: string;
  passage?: string;
  speaker?: string;
};

// Fetch videos from CMS content collection
const videoEntries = await getCollection('videos');

// Sort by date (newest first)
const cmsStudies: StudyEntry[] = videoEntries
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((entry) => ({
    id: entry.slug,
    title: entry.data.title,
    description: entry.data.description || '',
    category: entry.data.category || 'Bible Study',
    duration: entry.data.duration || '',
    date: entry.data.date,
    passage: entry.data.passage || '',
    speaker: entry.data.speaker || '',
  }));

// Featured video (most recent or marked as featured)
const featuredEntry = videoEntries.find(v => v.data.featured) || videoEntries[0];
const featured: StudyEntry = featuredEntry ? {
  id: featuredEntry.slug,
  title: featuredEntry.data.title,
  description: featuredEntry.data.description || '',
  category: featuredEntry.data.category || 'Bible Study',
  duration: featuredEntry.data.duration || '',
  date: featuredEntry.data.date,
  passage: featuredEntry.data.passage || '',
  speaker: featuredEntry.data.speaker || '',
} : {
  id: '',
  title: 'Wednesday Bible Study — Exodus 14: The Sea That Parts',
  description:
    'Mr. Sim walks through Exodus 14 — the moment the Israelites stand between the sea and the Egyptian army. What does it look like to hold onto hope when there is nowhere left to go? Written recap of the live discussion.',
  category: 'Bible Study',
  duration: '24:18',
  date: '2026-06-24',
  passage: 'Exodus 14',
  speaker: 'Mr. Sim',
};

// Studies list (all except featured)
const studies = cmsStudies.filter(s => s.id !== featured.id);
const allStudies = cmsStudies.length > 0 ? studies : [
  {
    id: '',
    title: 'The Gospel of John Chapter 3: Nicodemus at Night',
    description: 'Ms. Dora teaches John 3. Nicodemus comes to Jesus in the dark. What was he afraid of? What did he really want to know?',
    category: 'Bible Study',
    duration: '32:05',
    date: '2026-06-17',
    passage: 'John 3:1-21',
    speaker: 'Ms. Dora',
  },
  {
    id: '',
    title: 'Psalms for Real Life — Psalm 23 When You Are Burnt Out',
    description: 'A 20-minute reflective teaching on Psalm 23 for people who are tired, anxious, or just going through the motions.',
    category: 'Teaching',
    duration: '21:42',
    date: '2026-06-10',
    passage: 'Psalm 23',
    speaker: 'Mr. Sim',
  },
  {
    id: '',
    title: 'Parables Jesus Actually Told — The Lost Sheep',
    description: 'Why does Jesus tell this parable? Who gets lost? Who goes looking? A short message followed by group discussion.',
    category: 'Sermon',
    duration: '18:30',
    date: '2026-06-03',
    passage: 'Luke 15:1-7',
    speaker: 'Mr. Sim',
  },
];

const categories = ['All', ...Array.from(new Set(allStudies.map((v) => v.category)))];
---

<BaseLayout
  title="Recent Bible Study Series & Sermon Notes | Johannesburg Bible Study Church Sandton"
  description="Written recaps of recent Wednesday Bible study series, sermons, and community moments from Johannesburg Bible Study Church in Sandton, Johannesburg."
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <section class="relative overflow-hidden text-white py-16" style="background: linear-gradient(135deg, #1e3a5f 0%, #7c3aed 100%);">
    <div class="container-max relative text-center">
      <p class="text-blue-200 font-semibold uppercase tracking-wide text-sm mb-3">Recent Studies</p>
      <h1 class="heading-1 text-white mb-4">Wednesday Bible Study Notes & Recaps</h1>
      <p class="text-blue-100 text-lg max-w-2xl mx-auto">
        Catch up on recent Wednesday Bible study series, sermon notes, and community moments. Written summaries, key passages, and discussion questions.
      </p>
      {videoEntries.length === 0 && (
        <p class="text-sm text-amber-300 mt-4">
          Videos are managed through the CMS. <a href="/admin/" class="underline">Log in to add a video</a>.
        </p>
      )}
    </div>
  </section>

  <!-- Featured study -->
  <section class="section-padding">
    <div class="container-max">
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
        <p class="text-sm font-semibold uppercase tracking-wide text-gray-600">Most Recent Study</p>
      </div>
      <div class="grid lg:grid-cols-5 gap-8">
        <div class="lg:col-span-3">
          <div class="aspect-video rounded-xl overflow-hidden shadow-xl bg-gradient-to-br from-blue-900 via-purple-900 to-amber-700 p-8 flex flex-col justify-center text-white">
            <p class="text-xs font-semibold uppercase tracking-widest text-amber-200 mb-3">Featured Passage</p>
            <p class="text-3xl font-bold mb-2">{featured.passage}</p>
            <p class="text-lg opacity-90 mb-5">{featured.title.replace('Wednesday Bible Study — ', '')}</p>
            <div class="flex flex-wrap gap-3 mt-auto">
              <span class="text-xs bg-white/10 backdrop-blur px-3 py-1 rounded-full">Written notes</span>
              <span class="text-xs bg-white/10 backdrop-blur px-3 py-1 rounded-full">{featured.speaker}</span>
            </div>
          </div>
        </div>
        <div class="lg:col-span-2">
          <div class="flex flex-wrap gap-2 mb-3">
            <span class="text-xs bg-blue-100 text-blue-700 px-3 py-1 rounded-full font-medium">{featured.category}</span>
            <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">Written recap</span>
          </div>
          <h2 class="heading-2 mb-3">{featured.title}</h2>
          <p class="text-body mb-4">{featured.description}</p>
          <div class="text-sm text-gray-500 mb-6 space-y-1">
            <p><strong>Passage:</strong> {featured.passage}</p>
            <p><strong>Speaker:</strong> {featured.speaker}</p>
            <p><strong>Date:</strong> {new Date(featured.date).toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
          </div>
          <a href="/spiritual-education" class="btn-primary inline-block">Join Next Bible Study</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Category filters -->
  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="flex flex-wrap gap-3 mb-10">
        {categories.map((cat) => (
          <span class={`text-sm font-medium px-4 py-2 rounded-full ${cat === 'All' ? 'bg-blue-600 text-white' : 'bg-white text-gray-600 border border-gray-200'}`}>
            {cat}
          </span>
        ))}
      </div>

      <!-- What you can do right now instead -->
      <h2 class="heading-2 mb-6 text-center">In the meantime, here is how to follow along.</h2>
      <div class="grid gap-6 sm:grid-cols-3 mb-12">
        <a href="/spiritual-education" class="card text-center hover:border-blue-300 transition-colors block">
          <div class="text-3xl mb-3" aria-hidden="true">📖</div>
          <h3 class="font-semibold text-lg mb-2">Join Wednesday Live</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Every Wednesday at 7:30pm on Google Meet. Open to anyone, anywhere.
            Ask a question, get the notes.
          </p>
        </a>
        <a href="/blog" class="card text-center hover:border-blue-300 transition-colors block">
          <div class="text-3xl mb-3" aria-hidden="true">✍️</div>
          <h3 class="font-semibold text-lg mb-2">Read the Blog</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Long-form recaps of recent studies, plus stories from the community.
            New posts every week or two.
          </p>
        </a>
        <a href="/contact" class="card text-center hover:border-blue-300 transition-colors block">
          <div class="text-3xl mb-3" aria-hidden="true">✉️</div>
          <h3 class="font-semibold text-lg mb-2">Get Notes by Email</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Send us your email and we will send the next session's notes the day
            after each Wednesday study.
          </p>
        </a>
      </div>

      <div class="mt-4 text-center text-sm text-gray-500">
        <p>Real video recaps will replace this section once we start recording.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding text-center" style="background: linear-gradient(135deg, #7c3aed 0%, #db2777 100%);">
    <div class="container-max">
      <h2 class="heading-2 text-white mb-3">Be Part of Next Wednesday's Study</h2>
      <p class="text-purple-100 text-lg mb-6 max-w-xl mx-auto">
        Wednesday Bible studies happen live on Google Meet at 7:30pm. Drop in, ask a question, and you'll get the notes before next week's recap.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/spiritual-education" class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-purple-700 shadow-sm hover:bg-purple-50">
          Wednesday Bible Study
        </a>
        <a href="/contact" class="inline-flex items-center justify-center rounded-lg border border-white/40 bg-white/10 px-6 py-3 text-sm font-semibold text-white hover:bg-white/20">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</BaseLayout>