---
/**
 * src/pages/blog/index.astro
 *
 * Blog index. Refactored to consume the lib layer.
 *
 * Per Anti-Design-Debt principle #2 (interface before implementation)
 * this page calls `listBlogPosts()` and never `getCollection()`
 * directly. The same module is reusable for RSS, search, and the
 * homepage "latest" widget.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listBlogPosts, bandOf, type BlogBand } from '@/lib/modules/blog';
import { env } from '@/lib/env';

const { items: posts, source } = await listBlogPosts();
const config = env();

// Group posts by band for the sectioned listing UI.
const bandedPosts = new Map<BlogBand, typeof posts>();
for (const post of posts) {
  const band = bandOf(post);
  const list = bandedPosts.get(band) ?? [];
  list.push(post);
  bandedPosts.set(band, list);
}

const bandLabels: Record<BlogBand, string> = {
  devotional: 'Devotionals & Reflections',
  'sa-local': 'South African Life & Faith',
  beginner: 'For Beginners',
  pastoral: 'Pastoral Reflections',
  hymn: 'Hymns & Worship',
};
const bandOrder: readonly BlogBand[] = ['devotional', 'sa-local', 'beginner', 'pastoral', 'hymn'];
---
<BaseLayout
  title={`Blog | ${config.site.name}`}
  description="Articles on Bible study, faith, community, and church life from Johannesburg Bible Study Church in Sandton, Johannesburg."
>
  <section class="section-padding">
    <div class="container-max">
      <p class="text-blue-600 font-semibold uppercase tracking-wide text-sm mb-2">
        Blog & News
      </p>
      <h1 class="heading-1 mb-6">Articles & Updates</h1>
      <p class="text-body max-w-2xl mb-8">
        Articles on Bible study, faith, community life, and church activities from our community in Sandton, Johannesburg.
      </p>
      {source === 'fallback' && (
        <p class="text-sm text-amber-600 mb-4">
          Blog posts are managed through the CMS. <a href="/admin/" class="underline">Log in to write a new post</a>.
        </p>
      )}
    </div>
  </section>

  {bandOrder.map((band) => {
    const list = bandedPosts.get(band) ?? [];
    if (list.length === 0) return null;
    return (
      <section class="section-padding bg-gray-50">
        <div class="container-max">
          <h2 class="heading-2 mb-6">{bandLabels[band]}</h2>
          <div class="grid gap-8 lg:grid-cols-2 max-w-5xl">
            {list.map((post) => (
              <a href={`/blog/${post.slug}/`} class="card group hover:border-blue-200 hover:shadow-md">
                <p class="text-xs text-gray-500 mb-2">
                  {new Date(post.data.date).toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric' })}
                </p>
                <h3 class="heading-3 mb-3 group-hover:text-blue-700 transition-colors">{post.data.title}</h3>
                <p class="text-sm text-gray-600 mb-4">{post.data.description}</p>
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-full">{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section-padding text-center">
    <div class="container-max">
      <h2 class="heading-2 mb-4">Have a Topic in Mind?</h2>
      <p class="text-body max-w-xl mx-auto mb-6">
        If there is a topic you would like us to write about, or if you have a story to share, contact us.
      </p>
      <a href="/contact" class="btn-primary">Contact Us</a>
    </div>
  </section>
</BaseLayout>
