---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Comments from '@/components/Comments.astro';
import Share from '@/components/Share.astro';
import { getChurchSchema } from '@/components/Schema';

const schema = getChurchSchema();
---

<BaseLayout
  title="Visit Us | Sandton Bible Study Church, Johannesburg"
  description="Plan your visit to Johannesburg Bible Study Church in Sandton. Wednesday online Bible study, free Sunday Korean class, location, and contact details."
  schema={schema}
>
  <section class="section-padding">
    <div class="container-max">
      <h1 class="heading-1 mb-6">Plan Your Visit</h1>
      <p class="text-body max-w-2xl mb-12">
        We would love to welcome you. Here is everything you need to know before you join us for Bible study or community classes in Sandton, Johannesburg.
      </p>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="heading-2 mb-8">Our Gatherings</h2>
          <div class="space-y-6">
            <div class="card">
              <div class="flex items-start gap-4">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-blue-100 text-blue-700 font-bold shrink-0">BS</div>
                <div>
                  <h3 class="heading-3 mb-1">Wednesday Bible Study</h3>
                  <p class="text-blue-600 font-semibold">Online, 7:30pm via Google Meet</p>
                  <p class="text-sm text-gray-600 mt-2">Our primary weekly gathering. Online via Google Meet — join from anywhere in Johannesburg or beyond.</p>
                </div>
              </div>
            </div>
            <div class="card">
              <div class="flex items-start gap-4">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-amber-100 text-amber-700 font-bold shrink-0">KC</div>
                <div>
                  <h3 class="heading-3 mb-1">Free Korean Class</h3>
                  <p class="text-amber-600 font-semibold">Sunday 2:00pm, Offline, Parkmore Sandton</p>
                  <p class="text-sm text-gray-600 mt-2">Free Korean language class for the Johannesburg community. Appointment required — please call to register.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h2 class="heading-2 mb-8">Location & Contact</h2>
          <div class="card overflow-hidden p-0">
            <iframe
              title="Parkmore Sandton Map"
              src="https://www.openstreetmap.org/export/embed.html?bbox=28.0400%2C-26.1150%2C28.0700%2C-26.0900&amp;layer=mapnik&amp;marker=-26.1025%2C28.0550"
              class="w-full h-64 border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <div class="p-6">
              <h3 class="heading-3 mb-4">Address</h3>
              <p class="text-gray-700 mb-6">
                Parkmore, 11th Street<br />
                Sandton, 2196<br />
                Johannesburg, South Africa
              </p>
              <h3 class="heading-3 mb-4">Phone</h3>
              <p class="text-gray-700 mb-2">
                Mr. Sim: <a href="tel:+27774871295" class="text-blue-600 hover:underline">+27 77 487 1295</a>
                <a href="https://wa.me/27774871295" target="_blank" rel="noopener noreferrer" class="ml-2 inline-flex items-center gap-1 px-2 py-1 bg-[#25D366] hover:bg-[#20BD5A] text-white text-xs font-semibold rounded transition-colors">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp
                </a>
              </p>
              <p class="text-gray-700 mb-6">
                Ms. Dora: <a href="tel:+27674424461" class="text-blue-600 hover:underline">+27 67 442 4461</a>
                <a href="https://wa.me/27674424461" target="_blank" rel="noopener noreferrer" class="ml-2 inline-flex items-center gap-1 px-2 py-1 bg-[#25D366] hover:bg-[#20BD5A] text-white text-xs font-semibold rounded transition-colors">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp
                </a>
              </p>
              <a href="/contact" class="btn-primary">Contact Page</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-max">
      <h2 class="heading-2 mb-8 text-center">What to Expect</h2>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700 font-bold mb-3">W</div>
          <h3 class="font-semibold text-gray-900 mb-2">A Warm Welcome</h3>
          <p class="text-sm text-gray-600">Everyone is welcome. You will be greeted warmly by our community.</p>
        </div>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700 font-bold mb-3">B</div>
          <h3 class="font-semibold text-gray-900 mb-2">Bible Study</h3>
          <p class="text-sm text-gray-600">Thoughtful, practical Bible study that speaks to everyday life in Johannesburg.</p>
        </div>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700 font-bold mb-3">F</div>
          <h3 class="font-semibold text-gray-900 mb-2">Fellowship</h3>
          <p class="text-sm text-gray-600">Time to connect with others in the community and grow together.</p>
        </div>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700 font-bold mb-3">O</div>
          <h3 class="font-semibold text-gray-900 mb-2">Open to All</h3>
          <p class="text-sm text-gray-600">No church membership required. Our Bible study is open to the whole community.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <h2 class="heading-2 mb-6">Before You Join</h2>
          <div class="space-y-4">
            <div class="card">
              <h3 class="font-semibold text-gray-900 mb-2">For Wednesday Bible Study</h3>
              <p class="text-sm text-gray-600">
                Call us for the Google Meet link. You can join quietly at first, ask questions, or simply listen while you get comfortable.
              </p>
            </div>
            <div class="card">
              <h3 class="font-semibold text-gray-900 mb-2">For Sunday Korean Class</h3>
              <p class="text-sm text-gray-600">
                Please make an appointment before coming to Parkmore, Sandton. This helps us confirm class space and prepare learning materials.
              </p>
            </div>
            <div class="card">
              <h3 class="font-semibold text-gray-900 mb-2">For Youth Programs</h3>
              <p class="text-sm text-gray-600">
                Youth activities follow seasonal summer and winter schedules. Contact us for the next available program and age guidance.
              </p>
            </div>
          </div>
        </div>
        <div>
          <h2 class="heading-2 mb-6">Helpful Notes</h2>
          <div class="card space-y-5">
            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Best first step</p>
              <p class="text-gray-700">Call ahead so we can guide you to the right gathering and answer practical questions.</p>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Language</p>
              <p class="text-gray-700">Bible study and community communication are welcoming to English-speaking visitors. Korean class is beginner-friendly.</p>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Cost</p>
              <p class="text-gray-700">Bible study and Korean class are free. No membership fee is required to attend.</p>
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Location focus</p>
              <p class="text-gray-700">Our main physical meeting point is Parkmore, Sandton, with wider Bible study connections across Johannesburg.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-blue-700 text-white text-center">
    <div class="container-max">
      <h2 class="heading-2 text-white mb-4">Have Questions?</h2>
      <p class="text-blue-100 text-lg mb-6 max-w-xl mx-auto">
        We are happy to answer any questions before your visit. Contact us by phone.
      </p>
      <a href="/contact" class="btn-warm">Contact Us</a>
    </div>
  </section>

  <section class="section-tighter border-t border-gray-200">
    <div class="container-max">
      <Share title="Plan Your Visit | Sandton Bible Study Church" />
    </div>
  </section>

  <Comments pageSlug="visit" pageTitle="Plan Your Visit" topic="visit" />
</BaseLayout>
