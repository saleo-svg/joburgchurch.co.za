---
import BaseLayout from '@/layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Resources', url: '/resources/' },
  { name: 'Churches in Johannesburg', url: '/churches-in-johannesburg/' },
];
---

<BaseLayout
  title="Churches in Johannesburg: A Complete Guide | Sandton, Randburg, Fourways"
  description="A comprehensive guide to churches in Johannesburg and Sandton. Find Sunday services, Bible studies, online options, and community programs. Complete with contact details and service times."
  breadcrumbs={breadcrumbs}
>
  <section class="section-padding">
    <div class="container-max">
      <p class="text-blue-600 font-semibold uppercase tracking-wide text-sm mb-3">Church Directory</p>
      <h1 class="heading-1 mb-6">Churches in Johannesburg</h1>
      <p class="text-body max-w-3xl mb-8">
        Finding the right church in Johannesburg can feel overwhelming. This guide covers churches in Sandton, Randburg, Fourways, Midrand, and beyond — with service times, contact details, and what to expect.
      </p>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="max-w-4xl mx-auto">
        <h2 class="heading-2 mb-6">Churches in Sandton</h2>
        
        <div class="space-y-8">
          <!-- Sandton Bible Church -->
          <div class="card">
            <div class="flex items-start gap-4 mb-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-blue-100 text-blue-700 font-bold shrink-0">SB</div>
              <div>
                <h3 class="heading-3 mb-1">Sandton Bible Church</h3>
                <p class="text-sm text-blue-600 font-medium">Non-denominational evangelical</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 mb-4">
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
                <p class="text-sm text-gray-700">15 Leslie Avenue, Douglasdale, Sandton</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Times</p>
                <p class="text-sm text-gray-700">Sunday 8:00am, 10:00am, 5:30pm</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Contact</p>
                <p class="text-sm text-gray-700">+27 11 462 3206</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Website</p>
                <a href="https://sandtonbible.co.za" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">sandtonbible.co.za</a>
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-3">
              <strong>Best for:</strong> Families, individuals seeking structured teaching, people who prefer traditional evangelical worship.
            </p>
            <p class="text-sm text-gray-600">
              Established evangelical congregation with three Sunday services. Emphasizes biblical teaching and community through small groups. Programs for men, women, couples, and youth.
            </p>
          </div>

          <!-- Christ Church Sandton -->
          <div class="card">
            <div class="flex items-start gap-4 mb-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-blue-100 text-blue-700 font-bold shrink-0">CC</div>
              <div>
                <h3 class="heading-3 mb-1">Christ Church Sandton</h3>
                <p class="text-sm text-blue-600 font-medium">Anglican</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 mb-4">
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
                <p class="text-sm text-gray-700">Morningside, Sandton</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Times</p>
                <p class="text-sm text-gray-700">Sunday 9:00am</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Contact</p>
                <p class="text-sm text-gray-700">+27 78 309 3366</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Website</p>
                <a href="https://christchurch.co.za" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">christchurch.co.za</a>
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-3">
              <strong>Best for:</strong> People seeking liturgical worship, families with children, those who value theological depth.
            </p>
            <p class="text-sm text-gray-700">
              Anglican congregation with traditional worship and biblical teaching. Strong children's ministry (GAME) and growing youth program. Warm, reverent atmosphere with emphasis on community.
            </p>
          </div>

          <!-- Rivers Church Sandton -->
          <div class="card">
            <div class="flex items-start gap-4 mb-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-blue-100 text-blue-700 font-bold shrink-0">RC</div>
              <div>
                <h3 class="heading-3 mb-1">Rivers Church Sandton</h3>
                <p class="text-sm text-blue-600 font-medium">Non-denominational contemporary</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 mb-4">
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
                <p class="text-sm text-gray-700">Cnr South and Middle Roads, Morningside, Sandton</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Times</p>
                <p class="text-sm text-gray-700">Sunday 8:00am, 10:00am, 12:00pm, 5:00pm</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Contact</p>
                <p class="text-sm text-gray-700">+27 11 523 7000</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Website</p>
                <a href="https://rivers.church/sandton" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">rivers.church/sandton</a>
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-3">
              <strong>Best for:</strong> Young families, contemporary worship seekers, people looking for large community with small group options.
            </p>
            <p class="text-sm text-gray-700">
              Multi-campus church with contemporary worship style. Four Sunday services provide flexibility. Extensive programs for children, youth, and young adults. Focus on community through life groups.
            </p>
          </div>

          <!-- Manor Community Church -->
          <div class="card">
            <div class="flex items-start gap-4 mb-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-blue-100 text-blue-700 font-bold shrink-0">MC</div>
              <div>
                <h3 class="heading-3 mb-1">Manor Community Church</h3>
                <p class="text-sm text-blue-600 font-medium">Non-denominational</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 mb-4">
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
                <p class="text-sm text-gray-700">Corner Letaba Drive and Bowling Avenue, Gallo Manor, Sandton</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Times</p>
                <p class="text-sm text-gray-700">Sunday 9:00am (English), 3:00pm (Traditional)</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Contact</p>
                <p class="text-sm text-gray-700">+27 11 804 1679</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Website</p>
                <a href="https://manorchurch.org.za" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">manorchurch.org.za</a>
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-3">
              <strong>Best for:</strong> Traditional worship seekers, families, older congregation.
            </p>
            <p class="text-sm text-gray-700">
              Bible-based family church with traditional worship. Afternoon traditional service available. Wednesday prayer meetings offered.
            </p>
          </div>

          <!-- Johannesburg Bible Study Church -->
          <div class="card border-2 border-amber-200">
            <div class="flex items-start gap-4 mb-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-amber-100 text-amber-700 font-bold shrink-0">JB</div>
              <div>
                <h3 class="heading-3 mb-1">Johannesburg Bible Study Church</h3>
                <p class="text-sm text-amber-600 font-medium">Bible Study Community</p>
              </div>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 mb-4">
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
                <p class="text-sm text-gray-700">Parkmore, Sandton (Online gatherings primary)</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Service Times</p>
                <p class="text-sm text-gray-700">Wednesday 7:30pm (Online), Sunday 3:00pm (Korean Class)</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Contact</p>
                <p class="text-sm text-gray-700">+27 77 487 1295 (Mr. Sim)</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Website</p>
                <a href="https://joburgchurch.co.za" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">joburgchurch.co.za</a>
              </div>
            </div>
            <p class="text-sm text-gray-600 mb-3">
              <strong>Best for:</strong> Question-askers, people seeking in-depth Bible study, those who prefer online participation.
            </p>
            <p class="text-sm text-gray-700 mb-4">
              Focuses on Bible study rather than traditional Sunday services. Wednesday evening online Bible study is passage-based and discussion-oriented. Korean language class on Sunday afternoons. Small, welcoming community that prioritizes learning over programs.
            </p>
            <a href="/spiritual-education" class="text-sm font-semibold text-amber-600 hover:underline">Learn more about our Bible study →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-4xl mx-auto">
        <h2 class="heading-2 mb-6">Churches in Randburg</h2>
        
        <div class="card mb-8">
          <h3 class="heading-3 mb-3">Cornerstone Church Johannesburg</h3>
          <div class="grid gap-4 sm:grid-cols-2 mb-4">
            <div>
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Location</p>
              <p class="text-sm text-gray-700">Randburg area</p>
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1">Website</p>
              <a href="https://cornerstonechurch.co.za" target="_blank" rel="noopener noreferrer" class="text-sm text-blue-600 hover:underline">cornerstonechurch.co.za</a>
            </div>
          </div>
          <p class="text-sm text-gray-600">
            Contemporary worship, community-focused. Small groups and family ministries.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="max-w-4xl mx-auto">
        <h2 class="heading-2 mb-6">Types of Church Communities in Johannesburg</h2>
        
        <div class="grid gap-6 md:grid-cols-2">
          <div class="card">
            <h3 class="heading-3 mb-3">Megachurches</h3>
            <p class="text-sm text-gray-600 mb-3">
              Large congregations with thousands of weekly attendees. Multiple service times, extensive programs, professional facilities.
            </p>
            <p class="text-xs text-gray-500">
              <strong>Examples:</strong> Rivers Church, Christian Revival Church
            </p>
          </div>

          <div class="card">
            <h3 class="heading-3 mb-3">Mid-Size Churches</h3>
            <p class="text-sm text-gray-600 mb-3">
              100-500 attendees balancing community with programs. Often offer both traditional and contemporary options.
            </p>
            <p class="text-xs text-gray-500">
              <strong>Examples:</strong> Sandton Bible Church, Manor Community Church
            </p>
          </div>

          <div class="card">
            <h3 class="heading-3 mb-3">Small Churches & Bible Studies</h3>
            <p class="text-sm text-gray-600 mb-3">
              Groups of 10-100 people. Prioritize relationships and Bible study over programs. Often more personal and question-friendly.
            </p>
            <p class="text-xs text-gray-500">
              <strong>Examples:</strong> Johannesburg Bible Study Church, home groups
            </p>
          </div>

          <div class="card">
            <h3 class="heading-3 mb-3">Online Communities</h3>
            <p class="text-sm text-gray-600 mb-3">
              Communities that exist primarily or entirely online. Accessible from anywhere, lower pressure, flexible participation.
            </p>
            <p class="text-xs text-gray-500">
              <strong>Examples:</strong> Online Bible study groups, hybrid churches
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="heading-2 mb-4">Looking for a Bible Study Community?</h2>
        <p class="text-body max-w-2xl mx-auto mb-6">
          If you are specifically looking for a Bible study community that welcomes questions and exploration, join our Wednesday evening online gathering at 7:30pm.
        </p>
        <a href="/contact" class="btn-primary">Contact Us to Join</a>
      </div>
    </div>
  </section>
</BaseLayout>
