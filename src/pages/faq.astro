---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getFaqSchema } from '@/components/Schema';

const faqSchema = getFaqSchema([
  {
    question: "What is the Wednesday Bible study schedule?",
    answer: "Our Wednesday Bible study runs from 7:30pm to 9:00pm online via Google Meet. It is open to everyone in the Johannesburg and Sandton area. No commitment required to attend."
  },
  {
    question: "Is the Wednesday Bible study online or in person?",
    answer: "The Wednesday Bible study is online via Google Meet. You can join from anywhere in Johannesburg or beyond. We also hold an in-person Bible study on the first Saturday of each month at 4:00pm in Parkmore, Sandton."
  },
  {
    question: "Do I need to be a Christian to join the Bible study?",
    answer: "No. Our Bible study is open to everyone — Christians, seekers, doubters, and people just curious about the Bible. You do not need to believe anything specific to join."
  },
  {
    question: "What happens at the Wednesday Bible study?",
    answer: "We read a passage of the Bible together, then discuss it as a group. Questions are welcome. Mr. Sim or a volunteer leads the discussion. You can keep your camera on or off, speak or listen — whatever feels comfortable."
  },
  {
    question: "What is the Korean class about?",
    answer: "Ms. Dora teaches Korean language and culture every Sunday at 3:00pm in Parkmore, Sandton. The class covers Hangul (Korean alphabet), basic conversation, and Korean culture. Beginners are welcome. A course fee applies — please contact us for current fees before you register."
  },
  {
    question: "Do I need to register for the Korean class?",
    answer: "Yes, appointments are required. Please call Mr. Sim (+27 77 487 1295) or Ms. Dora (+27 67 442 4461) to register before attending. This helps us confirm space and prepare materials."
  },
  {
    question: "Is the Korean class free?",
    answer: "No. A course fee applies. Our website previously listed the class as free by mistake, and we have corrected that. Please call or WhatsApp for current fees. Church membership is not required."
  },
  {
    question: "What should I wear to church or Bible study?",
    answer: "There is no dress code. Most people wear casual or smart casual clothing. Come as you are."
  },
  {
    question: "Can I bring my children to the Bible study or Korean class?",
    answer: "For the Wednesday online Bible study, children are welcome to join if parents think it is appropriate. For the Sunday Korean class, please call ahead to discuss — we may be able to arrange childcare depending on the class size."
  },
  {
    question: "How do I join the WhatsApp group?",
    answer: "Contact Mr. Sim or Ms. Dora by phone or WhatsApp. They will add you to the group and send the Google Meet link before Wednesday sessions."
  },
  {
    question: "Is there a cost to attend any of your programs?",
    answer: "Wednesday Bible study and the first Saturday in-person study are free. The Sunday Korean class has a course fee. Please contact us for current Korean class fees. No offerings are expected from Bible study visitors."
  },
  {
    question: "Do I need church membership to attend?",
    answer: "No. All our programs are open to the entire Johannesburg and Sandton community. No membership is required for anything we offer."
  },
  {
    question: "What if I cannot attend every week?",
    answer: "There is no commitment to attend every week. Come when you can. We do not track attendance or expect regular participation. You are welcome to attend occasionally or regularly, whichever suits your life."
  },
  {
    question: "How is the Bible study different from a Sunday church service?",
    answer: "We do not run a traditional Sunday service with worship music and a sermon. Our focus is on Bible study and discussion. If you are looking for a traditional church service, we can recommend other churches in the Sandton area."
  },
  {
    question: "Can non-Christians attend?",
    answer: "Absolutely. Many people in our community are exploring faith, have questions about Christianity, or are simply curious. You do not need to be a Christian or believe anything specific to join us."
  }
]);

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'FAQ', url: '/faq/' },
];
---

<BaseLayout
  title="Bible Study & Church FAQ | Johannesburg Bible Study Church"
  description="Frequently asked questions about Johannesburg Bible Study Church — Wednesday online Bible study, Korean class in Sandton, membership, costs, and what to expect. All welcome."
  breadcrumbs={breadcrumbs}
  schema={faqSchema}
>
  <section class="section-padding">
    <div class="container-max">
      <p class="text-blue-600 font-semibold uppercase tracking-wide text-sm mb-3">Questions & Answers</p>
      <h1 class="heading-1 mb-6">Frequently Asked Questions</h1>
      <p class="text-body max-w-2xl mb-8">
        Common questions about our Wednesday Bible study, Korean class, church community, and what to expect when you visit or join us online.
      </p>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="container-max">
      <div class="max-w-3xl mx-auto">
        <h2 class="heading-2 mb-8">About Our Bible Study</h2>
        
        <details class="card mb-4 group" open>
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            What is the Wednesday Bible study schedule?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            Our Wednesday Bible study runs from <strong>7:30pm to 9:00pm</strong> online via Google Meet. It is open to everyone in the Johannesburg and Sandton area. No commitment required to attend.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Is the Wednesday Bible study online or in person?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            The Wednesday Bible study is <strong>online via Google Meet</strong>. You can join from anywhere in Johannesburg or beyond. We also hold an in-person Bible study on the <strong>first Saturday of each month at 4:00pm</strong> in Parkmore, Sandton.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Do I need to be a Christian to join?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            No. Our Bible study is open to <strong>everyone</strong> — Christians, seekers, doubters, and people just curious about the Bible. You do not need to believe anything specific to join.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            What happens at the Wednesday Bible study?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            We read a passage of the Bible together, then discuss it as a group. Questions are welcome. Mr. Sim or a volunteer leads the discussion. You can keep your camera on or off, speak or listen — whatever feels comfortable.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            What is the Korean class about?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            Ms. Dora teaches Korean language and culture every <strong>Sunday at 3:00pm</strong> in Parkmore, Sandton. The class covers Hangul (Korean alphabet), basic conversation, and Korean culture. Beginners are welcome. No materials needed — we provide everything.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Do I need to register for the Korean class?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            Yes, <strong>appointments are required</strong>. Please call Mr. Sim (+27 77 487 1295) or Ms. Dora (+27 67 442 4461) to register before attending. This helps us confirm space and prepare materials.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-max">
      <div class="max-w-3xl mx-auto">
        <h2 class="heading-2 mb-8">Practical Questions</h2>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Is the Korean class free?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            No. A <strong>course fee applies</strong>. Our website previously listed the class as free by mistake, and we have corrected that. Please call or WhatsApp for current fees. Church membership is not required.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            What should I wear to church or Bible study?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            There is <strong>no dress code</strong>. Most people wear casual or smart casual clothing. Come as you are.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Can I bring my children?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            For the Wednesday online Bible study, children are welcome to join if parents think it is appropriate. For the Sunday Korean class, please call ahead to discuss — we may be able to arrange childcare depending on the class size.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Is there a cost to attend?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            Wednesday Bible study and the first Saturday in-person study are <strong>free</strong>. The Sunday Korean class has a course fee. Please contact us for current Korean class fees. No offerings are expected from Bible study visitors.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Do I need church membership?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            No. All our programs are open to the <strong>entire Johannesburg and Sandton community</strong>. No membership is required for anything we offer.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            What if I cannot attend every week?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            There is <strong>no commitment</strong> to attend every week. Come when you can. We do not track attendance or expect regular participation. You are welcome to attend occasionally or regularly, whichever suits your life.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            How is the Bible study different from a Sunday church service?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            We do <strong>not run a traditional Sunday service</strong> with worship music and a sermon. Our focus is on Bible study and discussion. If you are looking for a traditional church service, we can recommend other churches in the Sandton area.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            Can non-Christians attend?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            <strong>Absolutely.</strong> Many people in our community are exploring faith, have questions about Christianity, or are simply curious. You do not need to be a Christian or believe anything specific to join us.
          </p>
        </details>

        <details class="card mb-4 group">
          <summary class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between">
            How do I join the WhatsApp group?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-4 text-gray-600">
            Contact Mr. Sim or Ms. Dora by phone or WhatsApp. They will add you to the group and send the Google Meet link before Wednesday sessions.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="section-padding bg-blue-50">
    <div class="container-max text-center">
      <h2 class="heading-2 mb-4">Still Have Questions?</h2>
      <p class="text-body max-w-xl mx-auto mb-6">
        If your question is not answered here, please contact us. We are happy to help.
      </p>
      <a href="/contact" class="btn-primary">Contact Us</a>
    </div>
  </section>
</BaseLayout>
